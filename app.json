{
  "expo": {
    "name": "Koarc Sudoku",
    "slug": "koarc-sudoku",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FCE2F7"
    },
    "assetBundlePatterns": ["**/*"],
    "platforms": ["ios", "android", "web"],
    "web": {
      "bundler": "metro",
      "output": "single",
      "backgroundColor": "#FCE2F7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.koracraft.koarcsudoku",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.koracraft.koarcsudoku",
      "permissions": ["INTERNET"]
    },
    "plugins": [
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
